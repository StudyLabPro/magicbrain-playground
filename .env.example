# Префикс имён экземпляра: контейнеры ${MBP_NAME}-playground и ${MBP_NAME}-api,
# закрытая сеть ${MBP_NAME}play-private, имена роутера и middleware в Traefik.
# Второй экземпляр (например, в режиме public) поднимается сменой MBP_NAME,
# COMPOSE_PROJECT_NAME и портов — без правки compose-файлов.
MBP_NAME=mb

# Домен стенда — используется только когда включён внешний маршрут.
# ВНИМАНИЕ: первый выпуск сертификата навсегда публикует имя домена в
# Certificate Transparency, и сканеры приходят в течение секунд. Выбирайте имя
# до первого включения маршрута, а не после.
MBP_DOMAIN=playground.example.com

# Внешняя docker-сеть, в которой работает обратный прокси (Traefik).
# Нужна только при MBP_TRAEFIK_ENABLE=true.
MBP_EDGE_NETWORK=edge

# Путь к клону MagicBrain — нужен только для make prepare/build.
MB_SRC=../MagicBrain

# Порты на loopback. Проверьте занятость (`ss -ltn`) перед запуском.
MBP_PORT=8007
MBP_API_PORT=8008

# Режим раскрытия. internal — всё, включая удаление прогонов и пути корпусов
# на диске. public — режим открытого показа: сценарии доступны все, но прогоны
# удалять нельзя и внутренние пути не отдаются. Любое другое значение —
# отказ на старте, чтобы опечатка не открывала лишнего.
MBP_DISCLOSURE=internal

# Внешний маршрут. false — контейнер не подключён к общей сети вовсе и доступен
# только на 127.0.0.1; true — подключается docker-compose.publish.yml и сервис
# публикуется на MBP_DOMAIN под basic-auth прокси.
MBP_TRAEFIK_ENABLE=false

# Basic-auth зашит в docker-compose.publish.yml и переменной не снимается:
# опечатка в .env не должна открыть стенд без пароля. Открытый показ без пароля
# — это отдельный файл docker-compose.public.yml и отдельное решение.

MBP_MAX_WORKERS=2
MBP_MAX_STEPS=200000
MBP_MAX_CHARS=200000

# Сколько прогонов держать на диске; лишние (самые старые) удаляются вместе
# с их моделями при сохранении нового прогона.
MBP_MAX_RUNS=500
